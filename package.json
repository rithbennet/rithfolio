{
  "name": "rithfolio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "biome lint --diagnostic-level=error . && astro check",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write src content BLOG_GUIDE.md README.md astro.config.mjs package.json tsconfig.json components.json",
    "deploy": "astro build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.2.6",
    "@astrojs/react": "^4.2.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.3.1",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/fragment-mono": "^5.3.0",
    "@giscus/react": "^3.1.0",
    "@tailwindcss/vite": "^4.2.0",
    "astro": "^5.8.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "reading-time": "^1.5.0",
    "sharp": "^0.34.5",
    "shiki": "^3.19.0",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@biomejs/biome": "^2.4.3",
    "@types/node": "^20",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.149.0"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
