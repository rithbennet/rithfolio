// rith.dev on Cloudflare Workers: a static-assets-only Worker serving the Astro build in dist/.
// Pushing to main builds and deploys it (Workers Builds, connected in the Cloudflare dashboard).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rithfolio",
  "account_id": "584717a5616edba9bb2c915d52c691e5",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "./dist",
    // /about/ redirects to /about, matching trailingSlash: "never" in astro.config.mjs
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "rith.dev", "custom_domain": true }],
  // only rith.dev serves the site; www redirects to it (workers/www-redirect)
  "workers_dev": false,
  "preview_urls": false
}
