---
// A horizontal bar chart, as in the AI reports. Bars are scaled to the largest value (or `max`).
// <Bars items={[{ label: "Opus", value: 90.17, display: "$90.17", note: "orchestrator", color: "c1" }]} />
// color: c1–c5 (the chart colours, in order) or neutral
interface Props {
  items: { label: string; value: number; display?: string; note?: string; color?: string }[];
  max?: number;
}
const { items, max = Math.max(...items.map((i) => i.value)) } = Astro.props;
const pct = (v: number) => (max > 0 ? Math.max(0, Math.min(100, (v / max) * 100)) : 0);
---

<div class="rows">
  {
    items.map((i) => (
      <div class="row">
        <div class="lab">
          {i.label}
          {i.note && <small>{i.note}</small>}
        </div>
        <div class="track">
          <div class="bar" style={`--v:${pct(i.value).toFixed(1)}%;--fill:var(--${i.color ?? "c1"})`} />
        </div>
        <div class="val">{i.display ?? i.value.toLocaleString("en-US")}</div>
      </div>
    ))
  }
</div>
