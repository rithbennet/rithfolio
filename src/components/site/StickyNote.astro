---
import Sprite from "./Sprite.astro";
import { site } from "../../data/site";

interface Props {
  eyebrow?: string;
  title?: string;
}
const {
  eyebrow = "Have something in mind?",
  title = "I'm always up for a good idea,<br />a hard problem, or a strange little project.",
} = Astro.props;
---

<section class="contact lamp" id="contact" aria-labelledby="contact-h">
  <svg class="stitch" viewBox="0 0 1000 18" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 9 C 120 4, 240 14, 360 9 S 600 4, 720 10 S 900 13, 1000 8"></path>
  </svg>
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="h2 contact-h" id="contact-h" set:html={title} />

  <div class="note-wrap">
    <div class="annot" aria-hidden="true">
      <span>Write to me</span>
      <svg viewBox="0 0 150 126">
        <path d="M130 6C113 51 92 70 57 91C45 98 34 103 17 105"></path>
        <path d="M33 88C27 96 21 103 16 106C25 106 34 109 42 116"></path>
      </svg>
    </div>
    <a class="note" href={`mailto:${site.email}?subject=Hello%20from%20rith.dev`}>
      <span>Say<br /><span class="u">hello<svg viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true"><path d="M2 7 C22 2 38 9 55 5 S80 8 98 4"></path></svg></span></span>
    </a>
    <div class="note-sprite"><Sprite pose="idle" label="Pixel Harith standing by" /></div>
  </div>
</section>

<style>
  .contact {
    position: relative;
    padding: 130px 24px 110px;
    text-align: center;
  }
  .stitch {
    position: absolute;
    top: 35px;
    left: 2vw;
    width: 96vw;
    height: 18px;
    opacity: 0.5;
  }
  .stitch path {
    fill: none;
    stroke: var(--muted);
    stroke-width: 3;
    stroke-dasharray: 20 19;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .contact-h {
    margin-top: 10px;
    font-size: calc(clamp(30px, 3vw, 43px) * var(--display-scale));
    line-height: 1.06;
  }
  .note-wrap {
    position: relative;
    width: 280px;
    margin: 92px auto 0;
  }
  .note {
    position: relative;
    display: grid;
    place-items: center;
    width: 280px;
    aspect-ratio: 1;
    background: linear-gradient(118deg, rgba(255, 255, 255, 0.14), transparent 32%), var(--note);
    box-shadow: var(--note-shadow);
    color: var(--note-ink);
    font: 600 64px/0.72 var(--font-hand);
    text-decoration: none;
    rotate: -1.6deg;
    transition: transform 0.19s var(--ease-hover);
  }
  .note:hover,
  .note:focus-visible {
    transform: translateY(-7px) rotate(2.6deg);
  }
  .note::after {
    content: "";
    position: absolute;
    right: 13px;
    bottom: 11px;
    width: 44px;
    height: 38px;
    background: linear-gradient(135deg, transparent 48%, rgba(119, 93, 51, 0.14) 49%);
  }
  .u {
    position: relative;
    display: inline-block;
  }
  .u svg {
    position: absolute;
    left: -6%;
    bottom: -19px;
    width: 112%;
    height: 12px;
    overflow: visible;
  }
  .u path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
  }
  .annot {
    position: absolute;
    top: -66px;
    left: 246px;
    width: 160px;
    rotate: 8deg;
    text-align: left;
  }
  .annot span {
    font: 31px var(--font-hand);
    color: var(--ink);
    white-space: nowrap;
  }
  .annot svg {
    display: block;
    width: 110px;
    margin: 2px 0 0 -40px;
    overflow: visible;
  }
  .annot path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .note-sprite {
    position: absolute;
    left: -64px;
    bottom: -6px;
  }
  @media (max-width: 720px) {
    .annot {
      display: none;
    }
    .note-sprite {
      left: -40px;
    }
  }
</style>
