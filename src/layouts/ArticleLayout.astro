---
// One page layout for diary entries and AI reports: a one-line header row (kind, date, reading time),
// an optional cover image, then tags and the series this belongs to, the text on the site's centred
// column, and a rail in the left margin with the contents and the series' parts.
import BaseLayout from "./BaseLayout.astro";
import Comments from "../components/Comments";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { slugify } from "../lib/utils";
import type { SeriesPosition } from "../lib/series";
import "../styles/article.css";

interface Props {
  title: string;
  description: string;
  url: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
  /** the header row, joined with " · ": e.g. Diary · 8 Oct 2026 · 6 min read · Kuala Lumpur */
  meta: { text: string; datetime?: string }[];
  standfirst: string;
  cover?: ImageMetadata;
  coverAlt?: string;
  coverCaption?: string;
  toc: { slug: string; text: string }[];
  /** number the ## sections (diaries); reports write their own numbers */
  numbered?: boolean;
  tags?: string[];
  series?: SeriesPosition;
}

const {
  title,
  description,
  url,
  ogImage,
  jsonLd,
  meta,
  standfirst,
  cover,
  coverAlt = "",
  coverCaption,
  toc,
  numbered = false,
  tags = [],
  series,
} = Astro.props;

const pad = (n: number) => String(n).padStart(2, "0");
const prev = series && series.index > 0 ? series.parts[series.index - 1] : undefined;
const next = series ? series.parts[series.index + 1] : undefined;
---

<BaseLayout
  title={title}
  description={description}
  canonical={url}
  ogType="article"
  ogUrl={url}
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <article class="entry">
    <header class="entry-hero">
      <p class="eyebrow">
        {
          meta.map((m, i) => (
            <>
              {i > 0 && " · "}
              {m.datetime ? <time datetime={m.datetime}>{m.text}</time> : m.text}
            </>
          ))
        }
      </p>
      <h1 class="h1 entry-title">{title}</h1>
      <p class="standfirst">{standfirst}</p>
    </header>

    {
      cover && (
        <figure class="cover">
          <Image
            src={cover}
            alt={coverAlt}
            widths={[672, 1008, 1344]}
            sizes="(max-width: 720px) calc(100vw - 48px), 672px"
            loading="eager"
            fetchpriority="high"
          />
          {coverCaption && <figcaption>{coverCaption}</figcaption>}
        </figure>
      )
    }

    <div class="head-foot">
      {
        tags.length > 0 && (
          <p class="tags">
            {tags.map((tag) => (
              <a href={`/blog/tag/${slugify(tag)}`}>#{slugify(tag)}</a>
            ))}
          </p>
        )
      }
      {
        series && (
          <a class="series-line" href={series.href}>
            Part {series.index + 1} of {series.parts.length} · {series.title} <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>

    <div class="entry-grid">
      <aside class="rail" aria-label="Contents">
        <a class="rail-back" href="/blog">← All entries</a>
        <p class="rail-title" id="rail-title" aria-hidden="true">{title}</p>
        {
          toc.length > 1 && (
            <>
              <p class="rail-h">Contents</p>
              <nav class="tree" id="entry-tree">
                {toc.map((h) => (
                  <a href={`#${h.slug}`}>
                    <span class="br" aria-hidden="true">└</span>
                    {h.text}
                  </a>
                ))}
              </nav>
            </>
          )
        }
        {
          series && (
            <nav class="rail-series" aria-label={`Series: ${series.title}`}>
              <p class="rail-h">Series</p>
              <a class="rail-series-title" href={series.href}>{series.title}</a>
              <ol>
                {series.parts.map((p, i) => (
                  <li>
                    <a class:list={{ on: i === series.index }} href={p.href} aria-current={i === series.index ? "page" : undefined}>
                      <span class="br">{pad(i + 1)}</span>
                      {p.title}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        <p class="prog" id="entry-prog" aria-hidden="true">
          <b></b><span class="tr"></span><span class="pct">00%</span>
        </p>
      </aside>

      <div class="entry-body">
        <div class:list={["prose", "entry-prose", { numbered }]} id="entry-prose">
          <slot />
        </div>

        <slot name="after" />

        {
          series && (prev || next) && (
            <nav class="series-nav" aria-label={`More in ${series.title}`}>
              {prev ? (
                <a class="sn prev" href={prev.href}>
                  <span class="sn-k">← Part {series.index} · {prev.kind}</span>
                  <span class="sn-t">{prev.title}</span>
                </a>
              ) : (
                <span />
              )}
              {next && (
                <a class="sn next" href={next.href}>
                  <span class="sn-k">Part {series.index + 2} · {next.kind} →</span>
                  <span class="sn-t">{next.title}</span>
                </a>
              )}
            </nav>
          )
        }

        <footer class="post-foot">
          <a href="/blog">← All entries</a>
        </footer>

        <Comments client:visible />
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  // contents rail: highlight the section being read, fill the progress meter, show the title once the h1 is gone
  const links = [...document.querySelectorAll<HTMLAnchorElement>("#entry-tree a")];
  const prose = document.getElementById("entry-prose");
  const prog = document.getElementById("entry-prog");
  const railTitle = document.getElementById("rail-title");
  const h1 = document.querySelector<HTMLElement>(".entry-title");
  const STEPS = 20;
  let ticking = false;

  function update() {
    ticking = false;
    if (prose && prog) {
      const r = prose.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight - r.top) / Math.max(1, r.height)));
      const k = Math.round(p * STEPS);
      prog.querySelector("b")!.textContent = "█".repeat(k);
      prog.querySelector(".tr")!.textContent = "░".repeat(STEPS - k);
      prog.querySelector(".pct")!.textContent = `${String(Math.round(p * 100)).padStart(2, "0")}%`;
    }
    if (railTitle && h1) railTitle.classList.toggle("on", h1.getBoundingClientRect().bottom < 0);
    const line = Math.min(innerHeight * 0.3, 240);
    let on = -1;
    links.forEach((a, i) => {
      const h = document.getElementById(decodeURIComponent(a.hash.slice(1)));
      if (h && h.getBoundingClientRect().top <= line) on = i;
    });
    links.forEach((a, i) => a.classList.toggle("on", i === on));
  }
  const request = () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  };
  addEventListener("scroll", request, { passive: true });
  addEventListener("resize", request);
  update();

  // the reports' charts read colours when drawn and redraw on resize, so nudge them when the theme flips
  new MutationObserver(() => dispatchEvent(new Event("resize"))).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });

  // copy button on code blocks
  document.querySelectorAll<HTMLElement>("[data-rehype-pretty-code-figure]").forEach((figure) => {
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "copy-code";
    btn.textContent = "Copy";
    btn.addEventListener("click", async () => {
      const pre = figure.querySelector('pre:not([style*="display: none"])') ?? figure.querySelector("pre");
      await navigator.clipboard.writeText(pre?.textContent ?? "");
      btn.textContent = "Copied";
      setTimeout(() => (btn.textContent = "Copy"), 1600);
    });
    figure.appendChild(btn);
  });
</script>

<style>
  /* one centred column for the header and the text, like the rest of the site.
     The contents rail sits in the left margin, so it never pushes the text off-centre. */
  .entry {
    padding: 120px 0 130px;
  }
  .entry-hero {
    width: var(--column);
    margin-inline: auto;
  }
  .entry-title {
    margin-top: 6px;
    font-size: calc(clamp(34px, 3.8vw, 50px) * var(--display-scale) * 1.1);
    line-height: 1.06;
    text-wrap: balance;
  }
  .standfirst {
    margin: 16px 0 0;
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--body);
    text-wrap: pretty;
  }
  /* the image head: the text column's width, always 16:9 (the same crop as on /blog) */
  .cover {
    width: var(--column);
    margin: 36px auto 0;
  }
  .cover :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 6px;
    box-shadow: var(--paper-shadow);
  }
  .cover figcaption {
    margin-top: 10px;
    font: 11px/1.5 var(--font-mono);
    color: var(--muted);
  }

  /* under the header (and cover): tags and the series line, closed by the site's dashed rule */
  .head-foot {
    display: grid;
    gap: 10px;
    width: var(--column);
    margin: 28px auto 0;
    padding-bottom: 28px;
    border-bottom: 1px dashed var(--rule);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin: 0;
    font: 11px/1.6 var(--font-mono);
  }
  .tags a {
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s;
  }
  .tags a:hover {
    color: var(--accent-text);
  }
  .series-line {
    justify-self: start;
    font: 10px/1.5 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-text);
    text-decoration: none;
  }
  .series-line:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .entry-grid {
    display: grid;
    grid-template-columns: 1fr minmax(0, 42rem) 1fr;
    column-gap: 48px;
    width: calc(100% - 48px);
    margin-inline: auto;
    padding-top: 56px;
  }
  .rail {
    position: sticky;
    top: 32px;
    align-self: start;
    justify-self: end;
    width: 13rem;
    max-height: calc(100dvh - 64px);
    overflow-y: auto;
    scrollbar-width: none;
    font-family: var(--font-mono);
  }
  .rail-back {
    display: inline-block;
    margin-bottom: 28px;
    font-size: 11px;
    color: var(--muted);
    text-decoration: none;
  }
  .rail-back:hover {
    color: var(--accent-text);
  }
  .rail-title {
    max-height: 0;
    margin: 0;
    overflow: hidden;
    opacity: 0;
    transform: translateY(8px);
    font: var(--display-weight) 17px/1.25 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--ink);
    text-wrap: balance;
    transition:
      opacity 0.4s,
      transform 0.4s var(--ease-out),
      max-height 0.4s,
      margin 0.4s;
  }
  .rail-title.on {
    max-height: 200px;
    margin-bottom: 24px;
    opacity: 1;
    transform: none;
  }
  .rail-h {
    margin: 0 0 10px;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--eyebrow);
  }
  .tree a {
    display: block;
    overflow: hidden;
    padding: 3px 0;
    font-size: 11.5px;
    line-height: 1.45;
    color: var(--body);
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 0.15s;
  }
  .tree a:hover,
  .tree a.on {
    color: var(--ink);
  }
  .tree .br {
    margin-right: 9px;
    color: var(--muted);
    transition: color 0.15s;
  }
  .tree a.on .br {
    color: var(--accent-text);
  }
  .rail-series {
    margin-top: 26px;
  }
  .rail-series-title {
    display: block;
    margin-bottom: 8px;
    font: var(--display-weight) 15px/1.3 var(--font-display);
    color: var(--ink);
    text-decoration: none;
  }
  .rail-series-title:hover {
    color: var(--accent-text);
  }
  .rail-series ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rail-series li a {
    display: block;
    overflow: hidden;
    padding: 3px 0;
    font-size: 11.5px;
    line-height: 1.45;
    color: var(--body);
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .rail-series li a:hover,
  .rail-series li a.on {
    color: var(--ink);
  }
  .rail-series .br {
    margin-right: 9px;
    color: var(--muted);
  }
  .rail-series a.on .br {
    color: var(--accent-text);
  }
  .prog {
    margin: 26px 0 0;
    overflow: hidden;
    font-size: 11px;
    white-space: nowrap;
    color: color-mix(in oklab, var(--muted) 55%, transparent);
  }
  .prog b {
    font-weight: 400;
    color: var(--accent);
  }
  .prog .pct {
    margin-left: 8px;
    color: var(--muted);
  }

  .entry-body {
    grid-column: 2;
    min-width: 0;
  }
  /* previous / next part of the series */
  .series-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 56px;
  }
  .sn {
    display: grid;
    gap: 6px;
    padding: 14px 16px 16px;
    border: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .sn:hover {
    border-color: var(--accent);
  }
  .sn.next {
    grid-column: 2;
    text-align: right;
  }
  .sn-k {
    font: 10px/1.5 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .sn-t {
    font: var(--display-weight) 17px/1.25 var(--font-display);
    letter-spacing: -0.01em;
  }
  .post-foot {
    margin-top: 48px;
    padding-top: 18px;
    border-top: 1px dashed var(--rule);
    font-size: 12.5px;
  }
  .post-foot a {
    color: var(--accent-text);
    text-decoration: none;
  }

  /* below this the margin is too narrow for the rail */
  @media (max-width: 1240px) {
    .entry-grid {
      grid-template-columns: minmax(0, 42rem);
      justify-content: center;
    }
    .rail {
      display: none;
    }
    .entry-body {
      grid-column: 1;
    }
  }
  @media (max-width: 560px) {
    .entry {
      padding-top: 100px;
    }
    .series-nav {
      grid-template-columns: 1fr;
    }
    .sn.next {
      grid-column: 1;
    }
    .cover {
      margin-top: 32px;
    }
  }

  :global(.copy-code) {
    position: absolute;
    top: 8px;
    right: 8px;
    padding: 3px 8px;
    border: 1px solid var(--rule);
    border-radius: 5px;
    background: var(--bg);
    color: var(--muted);
    font: 10px var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.15s;
  }
  :global([data-rehype-pretty-code-figure]:hover .copy-code),
  :global(.copy-code:focus-visible) {
    opacity: 1;
  }
</style>
