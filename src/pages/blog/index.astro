---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ReportClipping from "../../components/site/ReportClipping.astro";
import { getCollection } from "astro:content";
import { format } from "date-fns";
import { site } from "../../data/site";

const posts = (await getCollection("posts", ({ data }) => data.published)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const reports = (await getCollection("reports", ({ data }) => data.published)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const slug = (id: string) => id.replace(/\/index$/, "");
const [latest, ...rest] = posts;
---

<BaseLayout
  title="Blog"
  description="Harith's diary: building DagangNow, engineering notes, and the AI reports it argues with."
  canonical={`${site.url}/blog`}
  ogUrl={`${site.url}/blog`}
>
  <div class="page col">
    <p class="eyebrow">Diary</p>
    <h1 class="h1">Notes, mostly honest.</h1>
    <p class="intro">
      A diary of building things. Some entries discuss <a href="#reports">AI reports</a>: long, data-heavy write-ups an
      agent produces, which I then read, argue with, and write about here.
    </p>

    {
      latest && (
        <article class="latest">
          <p class="meta">
            {format(latest.data.date, "d MMM yyyy")}
            {latest.data.location && ` · ${latest.data.location}`}
          </p>
          <h2 class="h2 latest-title">
            <a href={`/blog/${slug(latest.id)}`}>{latest.data.title}</a>
          </h2>
          <p class="lead">{latest.data.description}</p>
          <a class="pill" href={`/blog/${slug(latest.id)}`}>
            Continue reading <span aria-hidden="true">→</span>
          </a>
        </article>
      )
    }

    {
      rest.length > 0 && (
        <section class="block" aria-labelledby="all-h">
          <h2 class="h3" id="all-h">All entries</h2>
          <ul class="rows">
            {rest.map((p) => (
              <li>
                <a class="row entry" href={`/blog/${slug(p.id)}`}>
                  <time datetime={p.data.date.toISOString()}>{format(p.data.date, "d MMM yy")}</time>
                  <span class="row-name">{p.data.title}</span>
                  <span class="row-cat">
                    {p.data.reports.length > 0
                      ? `${p.data.reports.length} report${p.data.reports.length > 1 ? "s" : ""}`
                      : (p.data.tags[0] ?? "")}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      reports.length > 0 && (
        <section class="block" id="reports" aria-labelledby="reports-h">
          <p class="eyebrow">AI reports</p>
          <h2 class="h3" id="reports-h">Reports the diary argues with</h2>
          <p class="note">
            Written by an AI agent, published as they came out. The stamp says which model wrote each one.
          </p>
          {reports.map((r) => (
            <ReportClipping id={r.id} />
          ))}
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .intro {
    max-width: 34rem;
    margin: 16px 0 0;
    font-size: 14.5px;
    line-height: 1.65;
    color: var(--body);
  }
  .intro a {
    color: var(--ink);
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .latest {
    margin-top: 64px;
  }
  .latest-title {
    margin: 8px 0 14px;
    font-size: calc(clamp(30px, 3vw, 40px) * var(--display-scale) * 1.1);
    line-height: 1.08;
  }
  .latest-title a {
    color: inherit;
    text-decoration: none;
  }
  .latest-title a:hover {
    color: var(--accent-text);
  }
  .lead {
    max-width: 36rem;
    margin: 0 0 20px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--body);
  }
  .block {
    margin-top: 72px;
  }
  .block .h3 {
    margin: 4px 0 14px;
  }
  .row.entry {
    grid-template-columns: 84px 1fr auto;
  }
  .row.entry time {
    font: 10px var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .note {
    margin: -4px 0 0;
    font-size: 13px;
    color: var(--muted);
  }
</style>
