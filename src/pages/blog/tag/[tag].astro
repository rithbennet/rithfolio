---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { format } from "date-fns";
import { slugify } from "../../../lib/utils";
import { site } from "../../../data/site";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => data.published);
  const tags = new Map<string, string>();
  posts.forEach((p) => p.data.tags.forEach((t) => tags.set(slugify(t), t)));
  return [...tags].map(([tag, label]) => ({ params: { tag }, props: { label } }));
}

const { tag } = Astro.params;
const { label } = Astro.props;
const posts = (await getCollection("posts", ({ data }) => data.published))
  .filter((p) => p.data.tags.some((t) => slugify(t) === tag))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title={`#${label}`} description={`Diary entries tagged ${label}.`} canonical={`${site.url}/blog/tag/${tag}`}>
  <div class="page col">
    <p class="eyebrow"><a href="/blog">Diary</a> · Tag</p>
    <h1 class="h1">#{label}</h1>
    <ul class="rows list">
      {
        posts.map((p) => (
          <li>
            <a class="row entry" href={`/blog/${p.id.replace(/\/index$/, "")}`}>
              <time datetime={p.data.date.toISOString()}>{format(p.data.date, "d MMM yy")}</time>
              <span class="row-name">{p.data.title}</span>
              <span />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .eyebrow a {
    color: inherit;
  }
  .list {
    margin-top: 40px;
  }
  .row.entry {
    grid-template-columns: 84px 1fr auto;
  }
  .row.entry time {
    font: 10px var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
</style>
