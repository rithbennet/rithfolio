---
// Everything tagged with one tag: diary entries and AI reports together, newest first.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { format } from "date-fns";
import { slugify } from "../../../lib/utils";
import { getFeed } from "../../../lib/feed";
import { site } from "../../../data/site";

export async function getStaticPaths() {
  const tags = new Set((await getFeed()).flatMap((item) => item.tags.map(slugify)));
  return [...tags].map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const items = (await getFeed()).filter((item) => item.tags.some((t) => slugify(t) === tag));
---

<BaseLayout
  title={`#${tag}`}
  description={`Diary entries and AI reports tagged ${tag}.`}
  canonical={`${site.url}/blog/tag/${tag}`}
>
  <div class="page col">
    <p class="eyebrow"><a href="/blog">Blog</a> · Tag</p>
    <h1 class="h1">#{tag}</h1>
    <ul class="rows list">
      {
        items.map((item) => (
          <li>
            <a class="row" href={item.href}>
              <span class="row-name">{item.title}</span>
              <span class="row-cat">{item.kind}</span>
              <time class="row-year" datetime={item.date.toISOString()}>
                {format(item.date, "d MMM")}
              </time>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .eyebrow a {
    color: inherit;
  }
  .list {
    margin-top: 40px;
  }
</style>
