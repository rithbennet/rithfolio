---
// A diary entry, on the same layout as the AI reports.
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import ReportClipping from "../../components/site/ReportClipping.astro";
import { articleComponents } from "../../components/article";
import { getImage } from "astro:assets";
import { getCollection, render } from "astro:content";
import { format } from "date-fns";
import readingTime from "reading-time";
import { getSeriesFor } from "../../lib/series";
import { site } from "../../data/site";

export async function getStaticPaths() {
  // drafts still open at their URL in dev
  const posts = await getCollection("posts", ({ data }) => data.published || import.meta.env.DEV);
  return posts.map((post) => ({ params: { slug: post.id.replace(/\/index$/, "") }, props: { post } }));
}

const { post } = Astro.props;
const { title, description, date, cover, coverAlt, coverCaption, location, tags, reports } = post.data;
const slug = post.id.replace(/\/index$/, "");
const { Content, headings } = await render(post);
const url = `${site.url}/blog/${slug}`;

const series = await getSeriesFor(`diary:${slug}`);
const minutes = Math.max(1, Math.round(readingTime(post.body ?? "").minutes));
const meta = [
  { text: "Diary" },
  { text: format(date, "d MMM yyyy"), datetime: date.toISOString() },
  { text: `${minutes} min read` },
  ...(location ? [{ text: location }] : []),
];

const ogImage = cover ? `${site.url}${(await getImage({ src: cover, width: 1200, format: "jpg" })).src}` : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  datePublished: date.toISOString(),
  description,
  url,
  ...(ogImage && { image: ogImage }),
  author: { "@type": "Person", name: site.fullName, url: site.url },
};
---

<ArticleLayout
  title={title}
  description={description}
  url={url}
  ogImage={ogImage}
  jsonLd={jsonLd}
  meta={meta}
  standfirst={description}
  cover={cover}
  coverAlt={coverAlt}
  coverCaption={coverCaption}
  toc={headings.filter((h) => h.depth === 2)}
  numbered
  tags={tags}
  series={series}
>
  <Content components={articleComponents} />

  {
    reports.length > 0 && (
      <section class="discussed" slot="after" aria-labelledby="discussed-h">
        <p class="eyebrow" id="discussed-h">
          Discussed in this entry
        </p>
        {reports.map((id) => (
          <ReportClipping id={id} compact />
        ))}
      </section>
    )
  }
</ArticleLayout>

<style>
  .discussed {
    margin-top: 48px;
  }
</style>
