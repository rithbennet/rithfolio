---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { scenes } from "../../lib/scenes";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const collections = await getCollection("gallery");
  return collections.map((c) => ({ params: { id: c.id }, props: { c } }));
}

const { c } = Astro.props;
const ratios = ["4/5", "3/2", "1/1", "3/4", "16/10"];
---

<BaseLayout
  title={c.data.title}
  description={c.data.summary}
  canonical={`${site.url}/gallery/${c.id}`}
  ogUrl={`${site.url}/gallery/${c.id}`}
>
  <div class="page wide">
    <header class="head">
      <p class="eyebrow"><a href="/gallery">Gallery</a> · {c.data.place} · {c.data.period}</p>
      <h1 class="h1">{c.data.title}</h1>
      <p class="intro">{c.data.summary}</p>
      {c.data.photos.length === 0 && <p class="standin">Stand-in tiles until the real photos are added.</p>}
    </header>

    <div class="masonry">
      {
        c.data.photos.length
          ? c.data.photos.map((p, i) => (
              <figure>
                <img src={p.src} alt={p.alt} loading="lazy" style={`aspect-ratio:${p.ratio ?? ratios[i % 5]}`} />
                {p.caption && <figcaption>{p.caption}</figcaption>}
              </figure>
            ))
          : c.data.standIn.map((s, i) => (
              <figure aria-hidden="true">
                <div class="frame" style={`aspect-ratio:${ratios[i % 5]}`} set:html={scenes[s](`${c.id}-${i}`)} />
              </figure>
            ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .head {
    max-width: 42rem;
  }
  .eyebrow a {
    color: inherit;
  }
  .intro {
    margin: 16px 0 0;
    font-size: 14.5px;
    color: var(--body);
  }
  .standin {
    margin: 10px 0 0;
    font: 10px/1.6 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--eyebrow);
  }
  .masonry {
    columns: 3 260px;
    column-gap: 22px;
    margin-top: 48px;
  }
  figure {
    break-inside: avoid;
    margin: 0 0 22px;
  }
  img,
  .frame {
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: 3px;
    object-fit: cover;
  }
  .frame :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }
  figcaption {
    margin-top: 8px;
    font: 600 22px/1 var(--font-hand);
    color: var(--ink);
  }
</style>
