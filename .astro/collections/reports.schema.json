            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "kind": {
          "type": "string",
          "default": "Report"
        },
        "model": {
          "type": "string"
        },
        "readingTime": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "highlights": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "published": {
          "type": "boolean",
          "default": true
        },
        "$schema": {
          "type": "string"
