[["Map",1,2,9,10,42,43,75,76,238,239],"meta::meta",["Map",3,4,5,6,7,8],"astro-version","5.17.3","content-config-digest","82b6a1f27f1521e0","astro-config-digest","{\"root\":{},\"srcDir\":{},\"publicDir\":{},\"outDir\":{},\"cacheDir\":{},\"site\":\"https://rith.dev\",\"compressHTML\":true,\"base\":\"/\",\"trailingSlash\":\"ignore\",\"output\":\"static\",\"scopedStyleStrategy\":\"attribute\",\"build\":{\"format\":\"directory\",\"client\":{},\"server\":{},\"assets\":\"_astro\",\"serverEntry\":\"entry.mjs\",\"redirects\":false,\"inlineStylesheets\":\"auto\",\"concurrency\":1},\"server\":{\"open\":false,\"host\":\"127.0.0.1\",\"port\":4321,\"streaming\":true,\"allowedHosts\":[]},\"redirects\":{\"/projects\":\"/work\",\"/skills\":\"/about\",\"/contact\":\"/#contact\",\"/reports\":\"/blog#reports\"},\"image\":{\"endpoint\":{\"route\":\"/_image\"},\"service\":{\"entrypoint\":\"astro/assets/services/sharp\",\"config\":{}},\"domains\":[],\"remotePatterns\":[],\"responsiveStyles\":false},\"devToolbar\":{\"enabled\":true},\"markdown\":{\"syntaxHighlight\":false,\"shikiConfig\":{\"langs\":[],\"langAlias\":{},\"theme\":\"github-dark\",\"themes\":{},\"wrap\":false,\"transformers\":[]},\"remarkPlugins\":[null],\"rehypePlugins\":[null,[null,{\"theme\":{\"dark\":\"github-dark\",\"light\":\"github-light\"}}],[null,{\"behavior\":\"append\",\"properties\":{\"className\":[\"anchor\"]}}]],\"remarkRehype\":{},\"gfm\":true,\"smartypants\":true},\"security\":{\"checkOrigin\":true,\"allowedDomains\":[]},\"env\":{\"schema\":{},\"validateSecrets\":false},\"experimental\":{\"clientPrerender\":false,\"contentIntellisense\":false,\"headingIdCompat\":false,\"preserveScriptOrder\":false,\"liveContentCollections\":false,\"csp\":false,\"staticImportMetaEnv\":false,\"chromeDevtoolsWorkspace\":false,\"failOnPrerenderConflict\":false,\"svgo\":false},\"legacy\":{\"collections\":false}}","posts",["Map",11,12,29,30],"hello-world",{"id":11,"data":13,"body":26,"filePath":27,"digest":28,"deferredRender":24},{"title":14,"date":15,"description":16,"coverImageSrc":17,"tags":18,"published":24,"reports":25},"Add a Typed MDX Blog to Your Next.js Portfolio (Contentlayer)",["Date","2025-01-01T00:00:00.000Z"],"Turn your existing Next.js portfolio into a fast, SEO-friendly blog with Contentlayer and MDX.","./cover.png",[19,20,21,22,23],"Next.js","MDX","Contentlayer","SEO","TypeScript",true,[],"Welcome to the blog! This is a seed post to verify listing, reading time, tags, and comments.\n\n## Why Contentlayer?\n\nContentlayer is a content SDK that transforms your content into type-safe JSON data. It works seamlessly with Next.js and provides:\n\n- **Type safety** - Full TypeScript support with auto-generated types\n- **MDX support** - Write content in MDX with custom components\n- **Computed fields** - Automatically calculate reading time, slugs, etc.\n- **Hot reload** - See changes instantly during development\n\n## Getting Started\n\nFirst, install the necessary dependencies:\n\n```bash\npnpm add contentlayer next-contentlayer reading-time\n```\n\nThen configure your content schema in `contentlayer.config.ts`:\n\n```typescript\nexport const Post = defineDocumentType(() => ({\n  name: \"Post\",\n  filePathPattern: `posts/**/*.mdx`,\n  contentType: \"mdx\",\n  fields: {\n    title: { type: \"string\", required: true },\n    date: { type: \"date\", required: true },\n    description: { type: \"string\", required: true },\n  },\n}));\n```\n\n## Features Included\n\nThis blog setup includes:\n\n1. **Auto reading time** - Calculated automatically from content\n2. **Tags with filter pages** - Navigate to `/blog/tag/[tag]` to filter\n3. **Giscus comments** - GitHub Discussions-powered comments\n4. **Full SEO** - Metadata, canonical URLs, sitemap, robots.txt, JSON-LD\n5. **Local search scaffold** - Simple search ready for enhancement\n\n## Next Steps\n\n- Add more posts in `content/posts/`\n- Customize the MDX components\n- Set up Giscus for comments\n- Deploy and verify SEO\n\nHappy blogging! 🚀","content/posts/hello-world/index.mdx","31afc4df25d233cb","why-typescript",{"id":29,"data":31,"body":39,"filePath":40,"digest":41,"deferredRender":24},{"title":32,"date":33,"description":34,"coverImageSrc":17,"tags":35,"published":24,"reports":38},"Why TypeScript?",["Date","2025-01-01T00:00:00.000Z"],"My reasons for using TypeScript over JavaScript.",[36,37],"nextjs","typescript",[],"Throughout my journey in software engineering, I've struggled with choosing which language to even use.\n\n## Why TypeScript?\n\nHonestly, no particular reason — it's the language I use for most of my work. My first touch with frameworks was Next.js, so I dove right into TypeScript with barely any prior knowledge. Even when coming from JavaScript, I had a lot to learn.\n\nAfter using TypeScript for a while, I can see the benefits of it over JavaScript. From improved tooling to fewer runtime surprises. More thoughts to come — lemme deploy this first and write tomorrow.","content/posts/why-typescript/index.mdx","a96dc8cca3c3124a","reports",["Map",44,45],"sub-agent-fanning",{"id":44,"data":46,"body":62,"filePath":63,"digest":64,"rendered":65},{"title":47,"date":48,"kind":49,"model":50,"readingTime":51,"summary":52,"highlights":53,"tags":58,"published":24},"One thread, three model families: what fanning work out to sub-agents cost and delivered",["Date","2026-10-06T00:00:00.000Z"],"Experiment report","Claude Opus 5.5","26 min read","One Opus orchestrator fanned DagangNow's staging QA out to ten Sonnet sub-agents and four GPT testers over two days. This is what it cost, what it shipped, and where the money went.",[54,55,56,57],"$147.09 API-equivalent","58 findings, 65 commits","92% saved by caching","20 min median fix",[59,60,61],"agents","cost","dagangnow","\u003C!-- The report itself is public/reports/sub-agent-fanning/index.html (self-contained HTML from the /report skill).\n     Source: ~/dev/experiments/sub-agent-fanning. Review for internal details before deploying (see docs/bio.md §8). -->","content/reports/sub-agent-fanning.md","fdac1073bf2f95b7",{"html":62,"metadata":66},{"headings":67,"localImagePaths":68,"remoteImagePaths":69,"frontmatter":70,"imagePaths":74},[],[],[],{"title":47,"date":71,"kind":49,"model":50,"readingTime":51,"summary":52,"highlights":72,"tags":73},["Date","2026-10-06T00:00:00.000Z"],[54,55,56,57],[59,60,61],[],"work",["Map",77,78,97,98,114,115,133,134,150,151,167,168,61,183,202,203,221,222],"achievtrack",{"id":77,"data":79,"filePath":87,"digest":88,"rendered":89},{"title":80,"kind":81,"category":82,"summary":83,"repo":84,"featured":85,"order":86,"published":24},"AchievTrack","project","Full-stack","Achievement and goal tracking for a primary school, SK Saujana Utama. Next.js, Prisma, Tailwind.","https://github.com/rithbennet/AchievTrack",false,10,"content/work/achievtrack.md","b4471087f44f6acf",{"html":90,"metadata":91},"",{"headings":92,"localImagePaths":93,"remoteImagePaths":94,"frontmatter":95,"imagePaths":96},[],[],[],{"title":80,"kind":81,"category":82,"summary":83,"repo":84,"order":86},[],"go-weather",{"id":97,"data":99,"filePath":105,"digest":106,"rendered":107},{"title":100,"kind":81,"category":101,"summary":102,"repo":103,"featured":85,"order":104,"published":24},"Go Weather","Go + React","Real-time weather with a Go backend and a TypeScript frontend.","https://github.com/rithbennet/go-weather-app",12,"content/work/go-weather.md","501649a1895fcd6b",{"html":90,"metadata":108},{"headings":109,"localImagePaths":110,"remoteImagePaths":111,"frontmatter":112,"imagePaths":113},[],[],[],{"title":100,"kind":81,"category":101,"summary":102,"repo":103,"order":104},[],"asterisk-digital",{"id":114,"data":116,"filePath":124,"digest":125,"rendered":126},{"title":117,"kind":118,"role":119,"period":120,"category":121,"summary":122,"featured":85,"order":123,"published":24},"Asterisk Digital","role","Intern","Internship","Mobile, cloud, data","Started on a React Native and Expo team, set up cloud infrastructure on AWS, then w