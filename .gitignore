# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.contentlayer/

# third-party reference screenshots (local only, not ours to publish)
docs/design/refs/

# raw photo drop for the gallery (originals stay local)
photos-inbox/

# local path for scripts/sync-docs.sh (machine-specific)
.drive-dir

# cloudflare
.wrangler
